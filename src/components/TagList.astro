---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags">
    {tags.map((tag) => (
      <li><a href={`/tags/${tag}/`}>#{tag}</a></li>
    ))}
  </ul>
)}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    font-size: 0.8rem;
  }
  .tags a {
    color: var(--pink);
    text-decoration: none;
  }
</style>
