---
import SiteFont from '../components/SiteFont.astro';

interface Props {
  title: string;
  description?: string;
  // 記事のページは 'article'、それ以外は 'website'
  type?: 'website' | 'article';
  publishedTime?: Date;
  // OGP の画像のパス（/og/... ）。省略するとサイト全体の画像
  ogImage?: string;
}

const {
  title,
  description = 'Stardust✨ が Web3 を観察する場所',
  type = 'website',
  publishedTime,
  ogImage = '/og/site.png',
} = Astro.props;
const siteName = 'stardust.box';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const nav = [
  { href: '/', label: 'Home' },
  { href: '/news/', label: 'News' },
  { href: '/notes/', label: 'Notes' },
  { href: '/projects/', label: 'Projects' },
  { href: '/onchain/', label: 'Onchain' },
  { href: '/lab/', label: 'Lab' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <!-- ライト・ダークの切り替え: 選んだモードを、色が出る前に当てる（一瞬違う色が出ないように）。
         選んでいなければ印を付けず、端末の設定に従う -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />

    <!-- OGP（X・Discord などで共有したときの表示） -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SiteFont />
    <!-- ページごとに head に足すもの（フォントなど） -->
    <slot name="head" />
  </head>
  <body>
    <header>
      <a class="site-name" href="/">STARDUST<span>.BOX</span></a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
        <button class="theme-toggle" type="button"></button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Stardust✨ · <a href="/tags/">Tags</a> · <a href="/rss.xml">RSS</a></p>
    </footer>
    <script is:inline>
      // ライト・ダークの切り替えのボタン。押すと反対のモードにして、ブラウザに覚えさせる
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('.theme-toggle');
        const dark = matchMedia('(prefers-color-scheme: dark)');
        const current = () => root.dataset.theme || (dark.matches ? 'dark' : 'light');
        const render = () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          button.textContent = next === 'dark' ? '☾ DARK' : '☀ LIGHT';
          button.setAttribute('aria-label', next === 'dark' ? 'ダークモードにする' : 'ライトモードにする');
        };
        button.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          render();
        });
        dark.addEventListener('change', render);
        render();
      })();
    </script>
  </body>
</html>

<style is:global>
  /* サイト全体のデザイン（#166）。星屑新報（#163・#165）と同じ和風サイバーの決まり:
     書体は M PLUS 1 Code だけ。色は墨・シアン・ピンクを文字にだけ使い、枠・背景の飾りには使わない。
     シアン = 主な色（リンク・強調・今いるページ）、ピンク = 見出し役の小さな文字・補助の強調 */
  :root {
    --fg: #0f172a; /* 墨 */
    --bg: #ffffff;
    --muted: #64748b;
    --line: color-mix(in srgb, var(--muted) 35%, transparent);
    --cyan: #0891b2;
    --pink: #db2777;
    --accent: var(--cyan);
    --font: 'M PLUS 1 Code', ui-monospace, Menlo, Consolas, monospace;
    color-scheme: light;
  }
  /* ダークモード: ボタンで選んだとき（data-theme="dark"）と、
     選んでいなくて端末がダークのとき（ライトを選んだときは除く）。色の中身は同じ */
  :root[data-theme='dark'] {
    --fg: #e2e8f0;
    --bg: #0b1120;
    --muted: #94a3b8;
    --cyan: #22d3ee;
    --pink: #f472b6;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --fg: #e2e8f0;
      --bg: #0b1120;
      --muted: #94a3b8;
      --cyan: #22d3ee;
      --pink: #f472b6;
      color-scheme: dark;
    }
  }
  body {
    margin: 0 auto;
    max-width: 42rem;
    padding: 1.5rem 1rem;
    font-family: var(--font);
    letter-spacing: 0.02em;
    line-height: 1.85;
    /* 長い URL などは、画面の端で折り返す（スマホではみ出さないように） */
    overflow-wrap: anywhere;
    color: var(--fg);
    background: var(--bg);
  }
  a {
    color: var(--cyan);
    text-underline-offset: 0.2em;
  }
  h1,
  h2,
  h3 {
    line-height: 1.45;
    letter-spacing: 0.04em;
  }
  h1 {
    font-size: 1.6rem;
    letter-spacing: 0.08em;
  }
  /* 見出し役の小さな文字（ピンク）。<h2 class="label"> などに付ける */
  .label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--pink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
    margin: 2.5rem 0 0.75rem;
  }
  img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  code {
    font-family: var(--font);
    font-size: 0.9em;
    color: var(--pink);
  }
  hr {
    border: none;
    border-top: 1px solid var(--line);
  }
  /* 表と引用は makimono と同じ形（細い線、見出しの行に薄いシアン） */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    margin: 1rem 0;
  }
  th,
  td {
    border: 1px solid var(--line);
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  th {
    background: color-mix(in srgb, var(--cyan) 8%, transparent);
    letter-spacing: 0.06em;
  }
  blockquote {
    margin: 1rem 0;
    padding: 0.25rem 1rem;
    border-left: 3px solid var(--cyan);
    color: var(--muted);
  }

  /* ---- ヘッダー（星屑新報の題字に合わせた小さな題字） ---- */
  header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--fg);
    margin-bottom: 2rem;
  }
  .site-name {
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--fg);
    text-decoration: none;
  }
  .site-name span {
    color: var(--cyan);
  }
  /* メニューだけ（ページの中の nav には効かせない） */
  header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  header nav a {
    color: var(--muted);
    text-decoration: none;
  }
  header nav a:hover {
    color: var(--cyan);
  }
  /* ライト・ダークの切り替えのボタン（メニューと同じ文字の形） */
  .theme-toggle {
    padding: 0 0.4rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: none;
    color: var(--muted);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--cyan);
    border-color: var(--cyan);
  }
  header nav a[aria-current='page'] {
    color: var(--cyan);
    font-weight: 700;
  }

  /* ---- フッター ---- */
  footer {
    margin-top: 3rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
</style>
