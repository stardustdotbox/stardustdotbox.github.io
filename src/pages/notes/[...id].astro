---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { formatDate, getPublishedNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, description, pubDate, updatedDate, tags, draft } = note.data;
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  ogImage={`/og/notes/${note.id}.png`}
>
  <article>
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <span>（更新 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>）</span>}
      {draft && <strong> 下書き</strong>}
    </p>
    <TagList tags={tags} />
    <Content />
  </article>
  <p><a href="/notes/">← Notes</a></p>
</Base>

<style>
  .meta {
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
</style>
